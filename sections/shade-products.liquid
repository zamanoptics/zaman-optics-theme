{%- liquid
  assign row_collection = section.settings.collection
  assign view_url = section.settings.link_url | default: row_collection.url
-%}
{%- if row_collection.products.size > 0 -%}
<section class="sh-section sh-container">
  <div class="sh-head sh-head--row">
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}<a class="sh-link" href="{{ view_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
  <div class="sh-grid">
    {%- for product in row_collection.products limit: section.settings.limit -%}
      {%- render 'shade-card', card_product: product -%}
    {%- endfor -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="sh-container sh-section"><p>Choose a collection that has products.</p></div>
{%- endif -%}
{% schema %}
{
  "name": "Shade product row",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Sunglasses"},
    {"type": "textarea", "id": "text", "label": "Text"},
    {"type": "collection", "id": "collection", "label": "Collection"},
    {"type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Shop all"},
    {"type": "url", "id": "link_url", "label": "Link", "info": "Defaults to the collection page."}
  ],
  "presets": [{"name": "Shade product row"}]
}
{% endschema %}
