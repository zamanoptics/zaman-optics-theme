<section class="sh-section sh-container">
  <div class="sh-head">
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <ul class="sh-cats">
    {%- for block in section.blocks -%}
      {%- assign cat = block.settings.collection -%}
      {%- if cat != blank -%}
        {%- assign cat_img = block.settings.image | default: cat.image | default: cat.products.first.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="sh-cat" href="{{ cat.url }}">
            <span class="sh-cat__img">{%- if cat_img -%}{{ cat_img | image_url: width: 720 | image_tag: widths: '320, 480, 720', sizes: '(min-width: 990px) 19vw, 46vw', loading: 'lazy', alt: '' }}{%- endif -%}</span>
            <span class="sh-cat__title">{{ block.settings.title | default: cat.title | escape }}</span>
            {%- if block.settings.caption != blank -%}<span class="sh-cat__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Shade categories",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Shop the range"},
    {"type": "textarea", "id": "text", "label": "Text"}
  ],
  "blocks": [
    {
      "type": "category", "name": "Category",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title."},
        {"type": "text", "id": "caption", "label": "Caption"},
        {"type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image or its first product."}
      ]
    }
  ],
  "presets": [{"name": "Shade categories"}]
}
{% endschema %}
