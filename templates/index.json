    "faq": {
      "type": "faq",
      "blocks": {
        "faq1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I enter my prescription?",
            "answer": "Choose prescription lenses on the product page and enter SPH, CYL, AXIS, and PD exactly as shown on your prescription. You can also upload a prescription file."
          }
        },
        "faq2": {
          "type": "faq_item",
          "settings": {
            "question": "What payment methods are available?",
            "answer": "Available payment options are shown at checkout, including supported online payment methods enabled for your order."
          }
        },
        "faq3": {
          "type": "faq_item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "Delivery time depends on your location and whether you need custom lenses. Contact our team for an estimate before ordering."
          }
        },
        "faq4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return my glasses?",
            "answer": "Contact us as soon as possible if your order needs attention. Our team will review the issue and guide you on the available return, exchange, or correction options."
          }
        },
        "faq5": {
          "type": "faq_item",
          "settings": {
            "question": "What is PD?",
            "answer": "PD is the distance between the centers of your pupils, measured in millimeters. It helps align prescription lenses correctly with your eyes."
          }
        },
        "faq6": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer progressive lenses?",
            "answer": "You can request progressive lenses through the prescription form. Our team needs to confirm the prescription, fitting measurements and final lens price."
          }
        }
      },
